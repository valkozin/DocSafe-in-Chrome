{
  "manifest_version": 3,
  "name": "File Safe",
  "short_name": "File Safe",
  "version": "1.0.5",
  "description": "Secure document storage with encryption and folder management",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "File Safe"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}